<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.7'>
  <!--
    Smart-warehouse world for the decentralised AMR fleet.

    Two things about this file are deliberate and easy to undo by accident:

    1. No <plugin> blocks at world level. Gazebo falls back to its own default
       server configuration, which loads Physics, UserCommands, SceneBroadcaster,
       Contact, Imu and Sensors with the correct library names for whichever
       version is installed. Hard-coding `ignition-gazebo-*-system` here builds a
       world that only runs on Fortress; hard-coding `gz-sim-*-system` builds one
       that only runs on Garden and later. Declaring nothing runs on both.

    2. The three fleet robots are spawned *here*, not by `ros_gz_sim create` in
       the launch file. Doing both is what produced duplicate `amr_1` entities,
       and a renamed entity silently moves its topics off `/model/amr_1/...`,
       which breaks every bridge.
  -->
  <world name='world_demo'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>-5 -3 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- ================= building ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Warehouse</uri>
      <name>warehouse</name>
      <pose>0 0 -0.09 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot-charging-station</uri>
      <name>charging_station</name>
      <pose>14.7 -10.6 -0.04 0 0 0</pose>
    </include>

    <!-- ================= racks ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_0</name>
      <pose>-9.34177 -13.5598 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_1</name>
      <pose>13.9821 15.319 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_2</name>
      <pose>6.19777 -12.9647 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_3</name>
      <pose>0.594376 -12.9647 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_4</name>
      <pose>-5.36284 -12.9647 0 0 -0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf</name>
      <pose>-4.41528 -0.690987 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_0</name>
      <pose>-4.41528 2.30697 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_1</name>
      <pose>-4.41528 5.30708 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_2</name>
      <pose>-4.41528 8.34352 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_3</name>
      <pose>5.60144 8.34352 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_4</name>
      <pose>5.60144 5.30708 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_5</name>
      <pose>5.60144 -0.690987 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_6</name>
      <pose>5.60144 2.30697 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_7</name>
      <pose>13.3818 -21.2416 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_8</name>
      <pose>13.3818 -19.0028 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_9</name>
      <pose>13.3818 -16.4478 0 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_10</name>
      <pose>13.3818 -14.1028 0 0 -0 0</pose>
    </include>

    <!-- ================= loose stock ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_mobile</name>
      <pose>4.4161 14.6952 0.01 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_mobile_0</name>
      <pose>4.45415 13.6212 0.01 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_mobile_1</name>
      <pose>4.4468 12.229 0.01 0 -0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box</name>
      <pose>-6.11913 13.7079 0.01 0 -0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_0</name>
      <pose>14.0222 -24.335 0.01 0 -0 0</pose>
      <static>true</static>
    </include>

    <!-- ================= carts at the pick faces ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/cart_model_2</uri>
      <name>cart1</name>
      <pose>-5.73 15 0.25 0 -0 0</pose>
    </include>

    <!--
      Fleet spawn poses, all facing north up the transit lanes. Every one has
      at least 1.75 m of clearance to the nearest rack, against the 0.55 m a
      robot centre needs; `python3 tools/build_map.py` re-checks that against
      the generated occupancy grid and fails loudly if a rack ever moves onto
      one of them.

      Six robots share two aisles on purpose. Three robots in a building this
      size almost never meet, and a coordination layer that is never exercised
      cannot be measured.
    -->
    <include>
      <name>amr_1</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>-2.9 -21.0 0.1 0 0 1.5708</pose>
    </include>
    <include>
      <name>amr_2</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>2.9 -21.0 0.1 0 0 1.5708</pose>
    </include>
    <include>
      <name>amr_3</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>-2.9 -16.0 0.1 0 0 1.5708</pose>
    </include>
    <include>
      <name>amr_4</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>2.9 -16.0 0.1 0 0 1.5708</pose>
    </include>
    <include>
      <name>amr_5</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>-12.9 -19.0 0.1 0 0 1.5708</pose>
    </include>
    <include>
      <name>amr_6</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Tugbot</uri>
      <pose>8.5 -21.0 0.1 0 0 1.5708</pose>
    </include>
  </world>
</sdf>
